{
  "name": "kaithangu",
  "devDependencies": {
    "@types/node": "22",
    "@vitest/coverage-v8": "^5.0.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  },
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:datastores": "bun run --filter scripts smoke:datastores",
    "smoke:supabase": "bun run --filter scripts smoke:supabase",
    "sim:quote-example": "bun run --filter scripts sim:quote-example",
    "db:generate": "bun run --filter @kaithangu/db db:generate",
    "db:migrate": "bun run --filter @kaithangu/db db:migrate",
    "db:studio": "bun run --filter @kaithangu/db db:studio",
    "db:seed": "bun run --filter @kaithangu/db db:seed",
    "db:seed:pincodes": "bun run --filter @kaithangu/db db:seed:pincodes",
    "i18n:translate": "bun run --filter scripts i18n:translate",
    "i18n:check": "bun run --filter scripts i18n:check",
    "audio:build": "bun run --filter scripts audio:build",
    "icons:build": "bun run --filter scripts icons:build",
    "bundle:check": "bun run --filter scripts bundle:check",
    "lhci": "bun run --filter web lhci",
    "db:reset": "echo 'db:reset is implemented in Phase 2'",
    "voice:sim": "echo 'voice:sim is implemented in the voice phase'",
    "voice:eval": "echo 'voice:eval is implemented in the voice phase'",
    "demo:reset": "echo 'demo:reset is implemented in the demo phase'"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ]
}
