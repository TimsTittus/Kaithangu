    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@kaithangu/core": "workspace:*",
    "@kaithangu/i18n": "workspace:*",
    "drizzle-orm": "0.45.2",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "yaml": "^2.9.0",
    "zod": "^4.6.1"
  }
