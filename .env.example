NODE_ENV=development
NEXT_PUBLIC_URL=http://localhost:3000

# Supabase Postgres (transaction pooler URL on port 6543 is fine)
DATABASE_URL=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# At least 32 random characters
SESSION_SECRET=
OTP_PEPPER=

# Twilio Verify (login OTP) — https://www.twilio.com/docs/verify/quickstarts/node-express
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender for non-OTP SMS, e.g. +14155551212
TWILIO_PHONE_NUMBER=
# Create a service at https://www.twilio.com/console/verify/services
TWILIO_VERIFY_SERVICE_SID=

# Bearer token for POST /api/webhook/ai (Sarvam Indus API tools)
AI_WEBHOOK_SECRET=

SPEECH_MODE=mock
SARVAM_API_KEY=