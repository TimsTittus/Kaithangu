# development | test | production
NODE_ENV=development
# Public base URL the browser/service worker use to reach this app
NEXT_PUBLIC_URL=http://localhost:3000

# Supabase Postgres (transaction pooler URL on port 6543 is fine; db:migrate
# switches to port 5432 automatically for the pooler host)
DATABASE_URL=

# Upstash Redis (REST API) — sessions and OTP rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Session cookie signing key and OTP hashing pepper — each at least 32 random
# characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=
OTP_PEPPER=

# Two-letter code of the state to use when none is otherwise known (state_config
# seed data), e.g. KL for the Kerala pilot
DEFAULT_STATE=KL

# Twilio Verify (login OTP) — https://www.twilio.com/docs/verify/quickstarts/node-express
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender for non-OTP SMS, e.g. +14155551212
TWILIO_PHONE_NUMBER=
# Create a service at https://www.twilio.com/console/verify/services
TWILIO_VERIFY_SERVICE_SID=

# mock (no external call, canned transcripts/audio) | real (Sarvam AI)
SPEECH_MODE=mock
# Required only when SPEECH_MODE=real — https://www.sarvam.ai
SARVAM_API_KEY=