# Copy to .env and fill in. Every app parses its own subset with zod at startup
# (src/env.ts) and exits with a list of anything missing or invalid.
# Never commit .env. Secrets below are intentionally empty.

# ---------------------------------------------------------------- runtime
# development | test | production
NODE_ENV=development

# ------------------------------------------------------ docker compose only
# Read by docker-compose.yml when creating the containers.
POSTGRES_USER=kaithangu
# Local-only password; pick anything and use the same value in the URLs below.
POSTGRES_PASSWORD=
# Host port for Postgres. Change it if 5432 is already taken on your machine.
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_DEFAULT_USER=kaithangu
RABBITMQ_DEFAULT_PASS=
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --------------------------------------------------------------- datastores
# postgres://USER:PASSWORD@localhost:POSTGRES_PORT/kaithangu
DATABASE_URL=
# Same server, separate database used by integration tests.
DATABASE_URL_TEST=
# redis://localhost:REDIS_PORT (booking accept locks, sessions, rate limits)
REDIS_URL=redis://localhost:6379
# amqp://USER:PASSWORD@localhost:RABBITMQ_PORT (job queues for apps/jobs)
RABBITMQ_URL=

# ------------------------------------------------------------------ secrets
# At least 32 random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=
# Server pepper for SHA-256 OTP hashes. At least 32 random characters.
OTP_PEPPER=

# ------------------------------------------------------------ adapter modes
# mock | real. mock runs the whole system offline with no API keys.
ADAPTER_MODE=mock
# Per-adapter overrides (mock | real). Leave empty to follow ADAPTER_MODE.
TELEPHONY_MODE=
SPEECH_MODE=
LLM_MODE=
PAYMENTS_MODE=
SMS_MODE=

# --------------------------------------------------------------- public URLs
# Exact public base URL of apps/web (used for webhook signature checks).
PUBLIC_BASE_URL=http://localhost:3000
# Exact public base URL of apps/voice (Twilio webhooks + media streams).
VOICE_PUBLIC_URL=http://localhost:4000
# Port and interface apps/voice listens on (0.0.0.0 inside containers).
VOICE_PORT=4000
VOICE_HOST=127.0.0.1

# ------------------------------------------------- telephony (Twilio, real)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164, e.g. +91XXXXXXXXXX
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------ speech (Sarvam, real)
SARVAM_API_KEY=

# ---------------------------------------------------------------- LLM (real)
# Provider name understood by the llm adapter.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# -------------------------------------------------------- payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------ services
# Base URL of apps/ml (FastAPI).
ML_SERVICE_URL=http://localhost:8000
# Directory for locally stored files (storage adapter, mock mode).
STORAGE_DIR=./storage
# Directory where mock SMS / call adapters write outgoing messages for inspection.
DEV_INBOX=./.dev-inbox

# -------------------------------------------------------------------- domain
# State code whose state_config row is the default (Kerala pilot).
DEFAULT_STATE=KL
# Seconds a worker has to accept a dispatch offer (AGENTS.md 6.4 default: 45).
OFFER_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------- demo/dev
# Pincode used by demo scripts. Must come from data files; left empty until verified (TODO_VERIFY).
DEMO_PINCODE=
# Your own phone (E.164) for real-mode smoke tests. Never commit it.
MY_TEST_PHONE=